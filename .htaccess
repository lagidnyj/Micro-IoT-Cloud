# ----------------------------------------------------------------------
# 1. Захист від сканування вмісту директорій
# ----------------------------------------------------------------------
Options -Indexes

<IfModule mod_dir.c>
    DirectoryIndex index.htm
</IfModule>

# ----------------------------------------------------------------------
# 2. Прокидання заголовка Authorization (Важливо для Apache!)
# Без цих рядків $_SERVER['HTTP_AUTHORIZATION'] у PHP може бути порожнім
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]
</IfModule>

# ----------------------------------------------------------------------
# 3. Заборона прямого доступу до папки storage з вебу
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteRule ^storage(/|$) - [F,NC]
    RewriteRule ^backend/watchdog\.php$ - [F,NC]
</IfModule>

# ----------------------------------------------------------------------
# 4. Базовий захист системних та конфігураційних файлів
# ----------------------------------------------------------------------
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "^(rules\.json|states\.json)$">
    Require all denied
</FilesMatch>

# API endpoints залишаються доступними за своїми токенами; решту обмежують
# окремими правилами вебсервера або доступом на рівні застосунку.
